# COMET extension module: GWP value sets + provenance (comet-ext-gwp-value-set)
# Assembled from CarbonSigProductHub/comet-carbonsig:
#   extensions/ipcc-gwp.ttl  (the ipcc: value-set vocabulary)
#   extensions/comet-pcr.ttl (the GWP-provenance section on comet-ef:GWP100Value)
# Source of truth is the core repo; this module surfaces the terms in the
# ontology browser. Do not hand-edit here — regenerate from the core repo.

@prefix ipcc:     <https://comet.carbon/vocab/ipcc-gwp#> .
@prefix comet-pcr:<https://comet.carbon/ext/pcr#> .
@prefix comet-ef: <https://comet.carbon/v1/emfactor#> .
@prefix comet-ver: <https://comet.carbon/v1/ver#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

#################################################################
# IPCC GWP value-set vocabulary (ipcc)
#
# A COMET-maintained controlled vocabulary of IPCC-derived GWP value SETS.
#
# WHY A REGISTRY AND NOT AN ENUM.
# A characterisation factor (a GWP) is only interpretable if you know which
# value set produced it. Naming the IPCC Assessment Report EDITION alone is
# under-determined: a single edition label can hide several distinct, published
# value sets that differ gas-by-gas. AR5 shipped GWP-100 both WITHOUT and WITH
# climate-carbon feedbacks; UNFCCC Decision 7/CP.27 adopted AR5 Table 8.A.1
# *excluding the fossil-methane value*; AR6 split methane into fossil and
# non-fossil (biogenic) values that earlier editions lack. So there are at
# least five value sets behind three edition labels — and the floor is not AR4
# but SAR, still embedded in transitioned Kyoto-era credit stock.
#
# An enum keyed on edition is therefore wrong for a structural reason, not a
# coverage reason: it conflates value sets an edition label cannot separate,
# and it must be amended at every new Assessment Report (AR7 lands around the
# UNFCCC's 2028 metric review). Keying on the value SET fixes both: new value
# sets are registry entries, never schema amendments, and the differences
# between value sets become machine-checkable relations (see ipcc:differsFrom).
#
# This vocabulary is a pending COMET extension (harvested into the registry as
# ipcc_pending). The four provenance properties that CARRY an ipcc value set on
# a factor — gwpValueSet, arBasis, arConfidence, gwpHorizon — live in the
# comet-pcr namespace (see extensions/comet-pcr.ttl).
#
# GWP-100 witness values below are the canonical figures for each value set,
# each carrying its own dcterms:source. They are a WITNESS set — the two gases
# (CH4, N2O) the arithmetic back-solve keys on, plus the CBAM-statutory
# fluorinated gases — not the full Annex table. Extend gas-by-gas as needed;
# every added value MUST cite its primary source.
#################################################################

<https://comet.carbon/vocab/ipcc-gwp>
    a owl:Ontology ;
    dcterms:title "IPCC GWP Value-Set Vocabulary"@en ;
    dcterms:description "A controlled vocabulary of IPCC-derived global-warming-potential value sets, identified by Assessment-Report edition AND variant (feedback treatment, methane fossil/biogenic split), with witness GWP-100 values and machine-checkable inter-set relations. Consumed via comet-pcr:gwpValueSet on comet-ef:GWP100Value."@en ;
    owl:versionInfo "0.1.0" ;
    dcterms:source "IPCC SAR (1995)", "IPCC AR4 (2007)", "IPCC AR5 WG1 Ch.8 (2013)",
                   "IPCC AR6 WG1 Ch.7 (2021)", "UNFCCC Decision 7/CP.27",
                   "GHG Protocol GWP update (Aug 2024)", "EU CBAM Implementing Regulation" .

#################################################################
# Scheme and top class
#################################################################

ipcc:valueSetScheme
    a skos:ConceptScheme ;
    rdfs:label "IPCC GWP value-set scheme"@en ;
    skos:definition "The enumeration of recognised IPCC GWP value sets. Members are identified by edition plus variant, not by edition alone."@en .

ipcc:GWPValueSet
    a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "GWP Value Set"@en ;
    skos:definition "A single, internally consistent set of global-warming-potential characterisation factors as published by one IPCC Assessment Report under one variant convention (feedback treatment and methane fossil/biogenic split)."@en .

#################################################################
# Structural properties on a value set
#################################################################

ipcc:edition
    a owl:DatatypeProperty ;
    rdfs:domain ipcc:GWPValueSet ; rdfs:range xsd:string ;
    rdfs:label "IPCC edition"@en ;
    skos:definition "The IPCC Assessment Report edition label this value set belongs to (SAR, AR4, AR5, AR6). Not sufficient on its own to identify the value set."@en .

ipcc:variant
    a owl:DatatypeProperty ;
    rdfs:domain ipcc:GWPValueSet ; rdfs:range xsd:string ;
    rdfs:label "variant"@en ;
    skos:definition "The convention that, together with the edition, pins the numeric values: e.g. 'no-feedback', 'with-feedback', 'UNFCCC-7CP27', 'fossil-CH4', 'biogenic-CH4'."@en .

ipcc:publicationYear
    a owl:DatatypeProperty ;
    rdfs:domain ipcc:GWPValueSet ; rdfs:range xsd:gYear ;
    rdfs:label "publication year"@en ;
    skos:definition "The year the underlying Assessment Report (or the adopting decision) published this value set. Vintage is the single most predictive feature when inferring a value set from metadata."@en .

ipcc:defaultHorizon
    a owl:ObjectProperty ;
    rdfs:domain ipcc:GWPValueSet ; rdfs:range comet-pcr:GWPHorizon ;
    rdfs:label "default time horizon"@en ;
    skos:definition "The GWP time horizon these witness values are stated on (GWP100 unless noted). A value set is horizon-specific: GWP20 and GWP100 are different numbers from the same report."@en .

ipcc:pactExportable
    a owl:DatatypeProperty ;
    rdfs:domain ipcc:GWPValueSet ; rdfs:range xsd:boolean ;
    rdfs:label "PACT-exportable"@en ;
    skos:definition "True iff this value set can be represented, without asserting anything false, in PACT's ipccCharacterizationFactors edition enum. SAR, AR4 and the indeterminate case are NOT PACT-exportable: PACT's enum cannot name them, so a COMET-faithful factor on one of these value sets is legitimately non-declarable into a PACT channel."@en .

ipcc:pactEnumValue
    a owl:DatatypeProperty ;
    rdfs:domain ipcc:GWPValueSet ; rdfs:range xsd:string ;
    rdfs:label "PACT enum value"@en ;
    skos:definition "The (lossy) edition string PACT's ipccCharacterizationFactors would receive on export, when pactExportable is true. The variant distinction is discarded in the collapse — which is exactly why the value set, not this string, is the COMET source of truth."@en .

#################################################################
# Witness GWP-100 values (per-gas, sourced)
#################################################################

ipcc:hasGWP
    a owl:ObjectProperty ;
    rdfs:domain ipcc:GWPValueSet ;
    rdfs:label "has GWP"@en ;
    skos:definition "Links a value set to one witness gas/factor pair used by the arithmetic back-solve."@en .

ipcc:forGas
    a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "for gas"@en ;
    skos:definition "The gas the witness GWP applies to (e.g. CH4, N2O, CF4). 'CH4-fossil' / 'CH4-nonfossil' where the value set distinguishes them."@en .

ipcc:gwp100
    a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:label "GWP-100"@en ;
    skos:definition "The 100-year global warming potential of the gas under this value set."@en .

#################################################################
# Inter-set relations (machine-checkable differences)
#################################################################

ipcc:differsFrom
    a owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:domain ipcc:GWPValueSet ; rdfs:range ipcc:GWPValueSet ;
    rdfs:label "differs from"@en ;
    skos:definition "Asserts that two value sets differ, with the specific gas(es) of difference given by ipcc:onGas on the same subject. Lets a consumer prove that two edition-sharing value sets are not interchangeable without recomputing."@en .

ipcc:onGas
    a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "on gas"@en ;
    skos:definition "Names the gas(es) on which an ipcc:differsFrom relation holds."@en .

ipcc:supersedes
    a owl:ObjectProperty ;
    rdfs:domain ipcc:GWPValueSet ; rdfs:range ipcc:GWPValueSet ;
    rdfs:label "supersedes"@en ;
    skos:definition "The earlier value set this one is the successor edition of (chronological lineage, not equivalence)."@en .

ipcc:isFloor
    a owl:DatatypeProperty ; rdfs:domain ipcc:GWPValueSet ; rdfs:range xsd:boolean ;
    rdfs:label "is registry floor"@en ;
    skos:definition "True for the earliest value set the registry admits (SAR). The floor exists because transitioned Kyoto-era units carry SAR-basis values that trade indefinitely."@en .

#################################################################
# Regulatory standing
#################################################################

ipcc:regulatoryStatus
    a owl:DatatypeProperty ; rdfs:domain ipcc:GWPValueSet ; rdfs:range xsd:string ;
    rdfs:label "regulatory status"@en ;
    skos:definition "Current standing of this value set in reporting practice: 'in-force' (required or accepted by at least one live destination), 'published-alternative' (a legitimately published set rarely selected for reporting), or 'archival' (historical/legacy basis, not accepted by any current destination)."@en .

ipcc:inForceFor
    a owl:DatatypeProperty ; rdfs:domain ipcc:GWPValueSet ; rdfs:range xsd:string ;
    rdfs:label "in force for"@en ;
    skos:definition "A named reporting destination or instrument that currently requires or accepts this value set. Multiple values allowed. Verify against the current instrument before relying on it."@en .

#################################################################
# The value sets
#################################################################

# --- SAR (1995): the floor ---
ipcc:SAR a ipcc:GWPValueSet, skos:Concept ;
    skos:inScheme ipcc:valueSetScheme ;
    skos:prefLabel "IPCC SAR GWP-100 (1995)"@en ;
    skos:definition "Second Assessment Report GWP-100 value set. The registry floor: transitioned CERs and Kyoto-era inventory data carry SAR-basis values and do not expire, so SAR is a live requirement, not merely archival."@en ;
    ipcc:edition "SAR" ; ipcc:variant "as-published" ; ipcc:publicationYear "1995"^^xsd:gYear ;
    ipcc:defaultHorizon comet-pcr:GWP100 ;
    ipcc:isFloor true ;
    ipcc:pactExportable false ;
    ipcc:hasGWP [ ipcc:forGas "CH4" ; ipcc:gwp100 21 ] ,
                [ ipcc:forGas "N2O" ; ipcc:gwp100 310 ] ;
    ipcc:regulatoryStatus "archival" ;
    skos:scopeNote "Retained because historical inventory datasets and legacy credit records remain on this basis; not accepted by any current reporting destination."@en ;
    dcterms:source "IPCC Second Assessment Report (1995), GWP-100; UNFCCC first-commitment-period reporting basis" .

# --- AR4 (2007) ---
ipcc:AR4 a ipcc:GWPValueSet, skos:Concept ;
    skos:inScheme ipcc:valueSetScheme ;
    skos:prefLabel "IPCC AR4 GWP-100 (2007)"@en ;
    skos:definition "Fourth Assessment Report GWP-100 value set. Still live: California ARB runs its emissions inventory on AR4, US EPA GHGRP reporting years RY2010–RY2023 are an AR4 archive, and Verra VCS permits AR4 conversion for pre-2021 vintages — so AR4 is permanently embedded in tradeable credit stock."@en ;
    ipcc:edition "AR4" ; ipcc:variant "as-published" ; ipcc:publicationYear "2007"^^xsd:gYear ;
    ipcc:defaultHorizon comet-pcr:GWP100 ;
    ipcc:supersedes ipcc:SAR ;
    ipcc:pactExportable false ;
    ipcc:hasGWP [ ipcc:forGas "CH4" ; ipcc:gwp100 25 ] ,
                [ ipcc:forGas "N2O" ; ipcc:gwp100 298 ] ,
                [ ipcc:forGas "CF4" ; ipcc:gwp100 7390 ] ,
                [ ipcc:forGas "C2F6" ; ipcc:gwp100 12200 ] ,
                [ ipcc:forGas "HFC-134a" ; ipcc:gwp100 1430 ] ;
    ipcc:regulatoryStatus "in-force" ;
    ipcc:inForceFor "California ARB current emissions inventory" ,
                    "Verra VCS reductions on or before 2020-12-31 (permitted alternative to AR5)" ,
                    "US EPA GHGRP reporting years 2010–2023 (archive basis)" ;
    skos:scopeNote "Live, not legacy: required for at least one major sub-national inventory and permanently embedded in pre-2021 voluntary credit stock. GHGRP Table A-1 moved toward AR5/AR6 for reporting year 2024 onward — confirm against current eCFR."@en ;
    dcterms:source "IPCC Fourth Assessment Report WG1 (2007), Table 2.14, GWP-100; CARB inventory basis; US EPA GHGRP Table A-1 (RY2010–RY2023)" .

# --- AR5 no-feedback (GHG Protocol convention) ---
ipcc:AR5-noFeedback a ipcc:GWPValueSet, skos:Concept ;
    skos:inScheme ipcc:valueSetScheme ;
    skos:prefLabel "IPCC AR5 GWP-100, without climate–carbon feedbacks"@en ;
    skos:definition "AR5 WG1 Table 8.A.1 GWP-100 values WITHOUT climate–carbon feedbacks. This is the GHG Protocol convention and the de-facto meaning of a bare 'AR5' tag in corporate accounting."@en ;
    ipcc:edition "AR5" ; ipcc:variant "no-feedback" ; ipcc:publicationYear "2013"^^xsd:gYear ;
    ipcc:defaultHorizon comet-pcr:GWP100 ;
    ipcc:supersedes ipcc:AR4 ;
    ipcc:pactExportable true ; ipcc:pactEnumValue "AR5" ;
    ipcc:hasGWP [ ipcc:forGas "CH4" ; ipcc:gwp100 28 ] ,
                [ ipcc:forGas "N2O" ; ipcc:gwp100 265 ] ,
                [ ipcc:forGas "CF4" ; ipcc:gwp100 6630 ] ,
                [ ipcc:forGas "C2F6" ; ipcc:gwp100 11100 ] ,
                [ ipcc:forGas "HFC-134a" ; ipcc:gwp100 1300 ] ;
    ipcc:regulatoryStatus "in-force" ;
    ipcc:inForceFor "EU CBAM in-scope gases" ,
                    "UK SECR and ESOS via DEFRA conversion factors" ,
                    "Australia NGER" ;
    dcterms:source "IPCC AR5 WG1 Ch.8 Table 8.A.1 (GWP-100, no climate-carbon feedback); GHG Protocol GWP update (Aug 2024)" .

# --- AR5 with-feedback ---
ipcc:AR5-withFeedback a ipcc:GWPValueSet, skos:Concept ;
    skos:inScheme ipcc:valueSetScheme ;
    skos:prefLabel "IPCC AR5 GWP-100, with climate–carbon feedbacks"@en ;
    skos:definition "AR5 WG1 Table 8.A.1 GWP-100 values WITH climate–carbon feedbacks. A distinct, published value set that a bare 'AR5' tag does not disambiguate from the no-feedback set."@en ;
    ipcc:edition "AR5" ; ipcc:variant "with-feedback" ; ipcc:publicationYear "2013"^^xsd:gYear ;
    ipcc:defaultHorizon comet-pcr:GWP100 ;
    ipcc:pactExportable true ; ipcc:pactEnumValue "AR5" ;
    ipcc:differsFrom ipcc:AR5-noFeedback ; ipcc:onGas "CH4" , "N2O" , "HFC-134a" ;
    ipcc:hasGWP [ ipcc:forGas "CH4" ; ipcc:gwp100 34 ] ,
                [ ipcc:forGas "N2O" ; ipcc:gwp100 298 ] ;
    ipcc:regulatoryStatus "published-alternative" ;
    skos:scopeNote "Rarely selected for reporting but present in some LCA datasets; distinguishing it prevents a silent per-gas mismatch. Climate–carbon feedbacks RAISE the value, so its HFC-134a exceeds the no-feedback 1300 — the exact figure is left unencoded pending confirmation against AR5 Table 8.A.1 rather than asserted from recall."@en ;
    dcterms:source "IPCC AR5 WG1 Ch.8 Table 8.A.1 (GWP-100, incl. climate-carbon feedback)" .

# --- AR5 UNFCCC variant (Decision 7/CP.27) ---
ipcc:AR5-UNFCCC a ipcc:GWPValueSet, skos:Concept ;
    skos:inScheme ipcc:valueSetScheme ;
    skos:prefLabel "IPCC AR5 GWP-100, UNFCCC 7/CP.27 variant"@en ;
    skos:definition "AR5 Table 8.A.1 GWP-100 as adopted by UNFCCC Decision 7/CP.27 for the Paris Enhanced Transparency Framework — EXCLUDING the AR5 fossil-methane value. Required for national reporting from no later than 31 Dec 2024."@en ;
    ipcc:edition "AR5" ; ipcc:variant "UNFCCC-7CP27" ; ipcc:publicationYear "2022"^^xsd:gYear ;
    ipcc:defaultHorizon comet-pcr:GWP100 ;
    ipcc:pactExportable true ; ipcc:pactEnumValue "AR5" ;
    ipcc:differsFrom ipcc:AR5-noFeedback ; ipcc:onGas "CH4-fossil" ;
    ipcc:hasGWP [ ipcc:forGas "CH4" ; ipcc:gwp100 28 ] ,
                [ ipcc:forGas "N2O" ; ipcc:gwp100 265 ] ,
                [ ipcc:forGas "HFC-134a" ; ipcc:gwp100 1300 ] ;
    ipcc:regulatoryStatus "in-force" ;
    ipcc:inForceFor "UNFCCC Enhanced Transparency Framework national inventory reporting" ;
    skos:scopeNote "Parties committed to reconsider common-metric values no later than 2028, so this concept has a foreseeable successor."@en ;
    dcterms:source "UNFCCC Decision 7/CP.27 (adopts AR5 Table 8.A.1 excluding the fossil-methane value)" .

# --- AR6 fossil methane ---
ipcc:AR6-fossilCH4 a ipcc:GWPValueSet, skos:Concept ;
    skos:inScheme ipcc:valueSetScheme ;
    skos:prefLabel "IPCC AR6 GWP-100, fossil methane"@en ;
    skos:definition "AR6 WG1 Ch.7 Table 7.15 GWP-100 using the FOSSIL methane value. Per the GHG Protocol Aug-2024 table, the fossil-methane value applies to fugitive emissions from oil, gas and coal and to industrial processes where the carbon is of fossil origin."@en ;
    ipcc:edition "AR6" ; ipcc:variant "fossil-CH4" ; ipcc:publicationYear "2021"^^xsd:gYear ;
    ipcc:defaultHorizon comet-pcr:GWP100 ;
    ipcc:supersedes ipcc:AR5-noFeedback ;
    ipcc:pactExportable true ; ipcc:pactEnumValue "AR6" ;
    ipcc:hasGWP [ ipcc:forGas "CH4-fossil" ; ipcc:gwp100 29.8 ] ,
                [ ipcc:forGas "N2O" ; ipcc:gwp100 273 ] ,
                [ ipcc:forGas "CF4" ; ipcc:gwp100 7380 ] ,
                [ ipcc:forGas "C2F6" ; ipcc:gwp100 12400 ] ,
                [ ipcc:forGas "HFC-134a" ; ipcc:gwp100 1530 ] ;
    ipcc:regulatoryStatus "in-force" ;
    ipcc:inForceFor "PACT v3 product carbon footprint exchange" ,
                    "GHG Protocol (most-recent-edition guidance, fossil sources)" ;
    dcterms:source "IPCC AR6 WG1 Ch.7 Table 7.15 (GWP-100, fossil CH4 = 29.8); GHG Protocol GWP update (Aug 2024)" .

# --- AR6 non-fossil / biogenic methane ---
ipcc:AR6-biogenicCH4 a ipcc:GWPValueSet, skos:Concept ;
    skos:inScheme ipcc:valueSetScheme ;
    skos:prefLabel "IPCC AR6 GWP-100, non-fossil (biogenic) methane"@en ;
    skos:definition "AR6 WG1 Ch.7 Table 7.15 GWP-100 using the NON-FOSSIL (biogenic) methane value — applies where methane's carbon is of biogenic origin (e.g. agriculture, landfill, biomass)."@en ;
    ipcc:edition "AR6" ; ipcc:variant "biogenic-CH4" ; ipcc:publicationYear "2021"^^xsd:gYear ;
    ipcc:defaultHorizon comet-pcr:GWP100 ;
    ipcc:pactExportable true ; ipcc:pactEnumValue "AR6" ;
    ipcc:differsFrom ipcc:AR6-fossilCH4 ; ipcc:onGas "CH4" ;
    ipcc:hasGWP [ ipcc:forGas "CH4-nonfossil" ; ipcc:gwp100 27.0 ] ,
                [ ipcc:forGas "N2O" ; ipcc:gwp100 273 ] ,
                [ ipcc:forGas "HFC-134a" ; ipcc:gwp100 1530 ] ;
    ipcc:regulatoryStatus "in-force" ;
    ipcc:inForceFor "GHG Protocol (most-recent-edition guidance, biogenic/agricultural sources)" ;
    skos:scopeNote "A single inventory may legitimately need both AR6 concepts on different lines (fossil vs biogenic methane). That is not a mixing violation; it is the AR6 convention applied correctly."@en ;
    dcterms:source "IPCC AR6 WG1 Ch.7 Table 7.15 (GWP-100, non-fossil CH4 = 27.0); GHG Protocol GWP update (Aug 2024)" .


#################################################################
# GWP provenance — value set, basis, confidence, horizon
#
# Four provenance properties on comet-ef:GWP100Value that make a
# characterisation factor's assessment-report basis explicit and recoverable.
# The value SET itself is a member of the ipcc: controlled vocabulary
# (extensions/ipcc-gwp.ttl); these properties CARRY it on a factor.
#
# WHY THIS EXISTS. The prior model — an Enum(AR5, AR6) — could not represent
# AR4 or SAR (both live in regulation and in tradeable credit stock), could not
# distinguish a DECLARED assessment-report basis from an INFERRED one (the
# provenance was lost the moment the number was read), and had no null-safe
# value meaning "indeterminate", so a factor of unknown basis had to assert
# something false or drop out of the graph. These four properties close exactly
# those three gaps, and gwpValueSet keys on the value set (edition + variant)
# rather than the edition label, so it never needs re-widening at AR7.
#
# Placed in comet-pcr as an evidence-gated pending extension; candidate to
# upstream onto comet-ef:GWP100Value in COMET core.
#################################################################

comet-pcr:gwpValueSet
    a owl:ObjectProperty ;
    rdfs:domain comet-ef:GWP100Value ;
    rdfs:range ipcc:GWPValueSet ;
    rdfs:label "GWP value set"@en ;
    skos:definition "The IPCC GWP value set (edition + variant) that produced this factor — a CURIE into the ipcc: controlled vocabulary, e.g. ipcc:AR6-fossilCH4, ipcc:AR5-noFeedback, ipcc:SAR. Supersedes the edition-only enum: absent (null) is legitimate and means the basis is indeterminate, in which case comet-pcr:arBasis MUST be comet-pcr:Indeterminate."@en ;
    rdfs:comment "Replaces the closed Enum(AR5, AR6). Keying on the value set, not the edition, lets COMET describe factors PACT's enum cannot express (SAR, AR4, variant sets); the export layer, not the ontology, decides what each destination accepts."@en ;
    skos:closeMatch comet-ef:GWP100Value.ipccAR ;
    dcterms:source "PACT v3 ipccCharacterizationFactors (extended); GHG Protocol; UNFCCC 7/CP.27" .

comet-pcr:arBasis
    a owl:ObjectProperty ;
    rdfs:domain comet-ef:GWP100Value ;
    rdfs:range comet-pcr:ARBasis ;
    rdfs:label "assessment-report basis"@en ;
    skos:definition "How the value set on this factor was established: declared by the source, arithmetically back-solved from a gas split and CO2e total, inferred by a model, or indeterminate."@en ;
    rdfs:comment "The provenance the enum could not carry. 'Declared' and 'back-solved' are effectively Type-A (determinate); 'inferred' carries comet-pcr:arConfidence; 'indeterminate' is the null-safe case."@en .

comet-pcr:arConfidence
    a owl:DatatypeProperty ;
    rdfs:domain comet-ef:GWP100Value ;
    rdfs:range xsd:decimal ;
    rdfs:label "assessment-report confidence"@en ;
    skos:definition "For the inferred case only: the model's confidence in the assigned value set, in [0,1] (e.g. P(value set | source, vintage, unit, sector, gas hints)). Absent when arBasis is declared or back-solved (both determinate)."@en ;
    dcterms:source "ISO 14067 uncertainty analysis; ecoinvent pedigree matrix" .

comet-pcr:gwpHorizon
    a owl:ObjectProperty ;
    rdfs:domain comet-ef:GWP100Value ;
    rdfs:range comet-pcr:GWPHorizon ;
    rdfs:label "GWP time horizon"@en ;
    skos:definition "The GWP time horizon the factor is stated on (GWP100 or GWP20). Defaults to GWP100. A methane factor near 80 tagged 'GWP-100 AR6' is almost certainly a GWP-20 mislabel — this property makes that anomaly detectable."@en .

comet-pcr:informedByRule
    a owl:ObjectProperty ;
    rdfs:domain comet-ef:GWP100Value ;
    rdfs:range comet-ver:DataSubstitutionRule ;
    rdfs:label "informed by rule"@en ;
    skos:definition "The documented substitution/inference rule (back-solve or model) that assigned the value set, so a verifier receiving the graph sees not just that a basis was assumed but which rule assumed it and with what confidence."@en ;
    rdfs:comment "Links the back-solve/inference method to the factor as a comet-ver:DataSubstitutionRule instance; keeps AR inference inside the existing verification findings workflow."@en .

#################################################################
# arBasis controlled vocabulary
#################################################################

comet-pcr:ARBasis
    a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Assessment-Report Basis"@en ;
    skos:definition "How a factor's GWP value set was established."@en .

comet-pcr:arBasisScheme
    a skos:ConceptScheme ;
    rdfs:label "AR basis scheme"@en ;
    skos:definition "The enumeration of ways a factor's value set can be established, in decreasing order of determinacy: declared, back-solved, inferred, indeterminate."@en .

comet-pcr:impliedConfidence
    a owl:DatatypeProperty ;
    rdfs:domain comet-pcr:ARBasis ;
    rdfs:range xsd:decimal ;
    rdfs:label "implied confidence"@en ;
    skos:definition "The confidence a basis category implies on its own, in [0,1]. Declared and back-solved are determinate (1.0); inferred carries a per-factor comet-pcr:arConfidence instead; indeterminate has none."@en .

comet-pcr:Declared a comet-pcr:ARBasis, skos:Concept ; skos:inScheme comet-pcr:arBasisScheme ;
    skos:prefLabel "declared"@en ;
    comet-pcr:impliedConfidence 1.0 ;
    skos:definition "The value set is stated by the source (e.g. a machine-readable tag). Determinate."@en .
comet-pcr:BackSolved a comet-pcr:ARBasis, skos:Concept ; skos:inScheme comet-pcr:arBasisScheme ;
    skos:prefLabel "back-solved"@en ;
    comet-pcr:impliedConfidence 1.0 ;
    skos:definition "The value set is arithmetically recovered from the gas split and the CO2e total — the cheapest determinate test, run before any model. Determinate, effectively Type-A. Where a unique solution exists this is evidentially equivalent to a declaration and export gates should treat it as such."@en .
comet-pcr:Inferred a comet-pcr:ARBasis, skos:Concept ; skos:inScheme comet-pcr:arBasisScheme ;
    skos:prefLabel "inferred"@en ;
    skos:definition "The value set is assigned by a model from metadata; carries comet-pcr:arConfidence (below 1) and propagates its own uncertainty. Should link the assigning rule via comet-pcr:informedByRule."@en .
comet-pcr:Indeterminate a comet-pcr:ARBasis, skos:Concept ; skos:inScheme comet-pcr:arBasisScheme ;
    skos:prefLabel "indeterminate"@en ;
    skos:definition "The value set cannot be established. gwpValueSet is absent; the factor is non-declarable into a regulated or PACT channel until resolved."@en .

#################################################################
# GWP time-horizon controlled vocabulary
#################################################################

comet-pcr:GWPHorizon
    a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "GWP Time Horizon"@en ;
    skos:definition "The integration time horizon of a global warming potential."@en .

comet-pcr:gwpHorizonScheme
    a skos:ConceptScheme ;
    rdfs:label "GWP horizon scheme"@en ;
    skos:definition "The enumeration of GWP time horizons COMET recognises."@en .

comet-pcr:GWP100 a comet-pcr:GWPHorizon, skos:Concept ; skos:inScheme comet-pcr:gwpHorizonScheme ;
    skos:prefLabel "GWP-100 (100-year)"@en ; skos:notation "default" .
comet-pcr:GWP20 a comet-pcr:GWPHorizon, skos:Concept ; skos:inScheme comet-pcr:gwpHorizonScheme ;
    skos:prefLabel "GWP-20 (20-year)"@en .
